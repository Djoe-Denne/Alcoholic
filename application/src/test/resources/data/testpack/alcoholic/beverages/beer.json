{
  "id": "testpack:beer",
  "category": "beer",
  "graph": {
    "nodes": [
      {
        "id": "malt",
        "process": "alcoholic:malt",
        "inputs": {
          "grain": {
            "tag": "alcoholic:barley"
          }
        },
        "outputs": [
          "malt"
        ]
      },
      {
        "id": "mill",
        "process": "alcoholic:mill",
        "inputs": {
          "malt": {
            "node": "malt",
            "port": "malt"
          }
        },
        "outputs": [
          "grist"
        ]
      },
      {
        "id": "mash",
        "process": "alcoholic:mash",
        "inputs": {
          "grist": {
            "node": "mill",
            "port": "grist"
          },
          "water": {
            "item": "minecraft:water_bucket"
          }
        },
        "outputs": [
          "wort"
        ]
      },
      {
        "id": "boil",
        "process": "alcoholic:boil",
        "inputs": {
          "wort": {
            "node": "mash",
            "port": "wort"
          },
          "hops": {
            "tag": "alcoholic:hops"
          }
        },
        "outputs": [
          "hopped_wort"
        ]
      },
      {
