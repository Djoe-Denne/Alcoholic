          }
        },
        "outputs": [
          "finished"
        ]
      },
      {
        "id": "age",
        "process": "alcoholic:age",
        "config": {
          "input_liquid": "testpack:beer",
          "output": { "liquid": "testpack:barrel_aged_beer" },
          "ticks_to_complete": 40
        },
        "inputs": {
          "beer": { "node": "ferment", "port": "finished" }
        },
        "outputs": ["aged"]
      }
    ],
    "outputs": {
      "result": {
        "node": "age",
        "port": "aged"
      }
    }
  },
  "properties": [
    "alcoholic:sugar",
    "alcoholic:ethanol",
    "alcoholic:bitterness",
    "alcoholic:carbonation"
